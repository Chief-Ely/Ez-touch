<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menuSettingsRoot"
    android:layout_width="280dp"
    android:layout_height="280dp"
    android:background="@drawable/bg_floating_menu"
    android:padding="16dp">

    <!-- Center: Back -->
    <LinearLayout
        android:id="@+id/btnBackToMain"
        style="@style/FloatingMenuItem"
        android:layout_centerInParent="true">
        <ImageView
            style="@style/FloatingMenuIcon"
            android:src="@android:drawable/ic_menu_revert" />
        <TextView
            style="@style/FloatingMenuText"
            android:text="Back" />
    </LinearLayout>

    <!-- Top: Flashlight -->
    <LinearLayout
        android:id="@+id/btnFlashlight"
        style="@style/FloatingMenuItem"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="12dp">
        <ImageView
            android:id="@+id/imgTorchIcon"
            style="@style/FloatingMenuIcon"
            android:src="@drawable/light_off" />
        <TextView
            style="@style/FloatingMenuText"
            android:text="Flashlight" />
    </LinearLayout>

    <!-- Right: Volume Up -->
    <LinearLayout
        android:id="@+id/btnVolumeUp"
        style="@style/FloatingMenuItem"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginRight="12dp">
        <ImageView
            style="@style/FloatingMenuIcon"
            android:src="@drawable/volume_up" />
        <TextView
            style="@style/FloatingMenuText"
            android:text="Volume +" />
    </LinearLayout>

    <!-- Bottom: Volume Down -->
    <LinearLayout
        android:id="@+id/btnVolumeDown"
        style="@style/FloatingMenuItem"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="12dp">
        <ImageView
            style="@style/FloatingMenuIcon"
            android:src="@drawable/volume_down" />
        <TextView
            style="@style/FloatingMenuText"
            android:text="Volume -" />
    </LinearLayout>

    <!-- Left: Rotate -->
    <LinearLayout
        android:id="@+id/btnAutoRotate"
        style="@style/FloatingMenuItem"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_marginLeft="12dp">
        <ImageView
            android:id="@+id/imgRotateIcon"
            style="@style/FloatingMenuIcon"
            android:src="@drawable/rotate" />
        <TextView
            android:id="@+id/txtRotationLabel"
            style="@style/FloatingMenuText"
            android:text="Rotate" />
    </LinearLayout>

</RelativeLayout>
