<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menuMainRoot"
    android:layout_width="300dp"
    android:layout_height="300dp"
    android:background="@drawable/bg_floating_menu"
    android:orientation="vertical"
    android:padding="20dp"
    android:weightSum="3">

    <!-- Top Row: Settings & Screen Lock -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btnMenuSetting"
            style="@style/FloatingMenuItem"
            android:layout_margin="6dp">
            <ImageView style="@style/FloatingMenuIcon" android:src="@android:drawable/ic_menu_preferences" />
            <TextView style="@style/FloatingMenuText" android:text="Settings" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnMenuLock"
            style="@style/FloatingMenuItem"
            android:layout_margin="6dp">
            <ImageView style="@style/FloatingMenuIcon" android:src="@android:drawable/ic_lock_power_off" />
            <TextView style="@style/FloatingMenuText" android:text="Lock" />
        </LinearLayout>
    </LinearLayout>

    <!-- Middle Row: Screenshot & Home -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btnMenuScreenshot"
            style="@style/FloatingMenuItem"
            android:layout_margin="6dp">
            <ImageView style="@style/FloatingMenuIcon" android:src="@android:drawable/ic_menu_camera" />
            <TextView style="@style/FloatingMenuText" android:text="Screenshot" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnMenuHome"
            style="@style/FloatingMenuItem"
            android:layout_margin="6dp">
            <ImageView style="@style/FloatingMenuIcon" android:src="@android:drawable/ic_menu_view" />
            <TextView style="@style/FloatingMenuText" android:text="Home" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Row: Return to Ez-touch App -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btnMenuMain"
            style="@style/FloatingMenuItem"
            android:layout_margin="6dp">
            <ImageView style="@style/FloatingMenuIcon" android:src="@android:drawable/ic_menu_compass" />
            <TextView style="@style/FloatingMenuText" android:text="Ez-touch" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>