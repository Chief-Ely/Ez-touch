<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/menuMainRoot"
    android:layout_width="280dp"
    android:layout_height="280dp"
    android:background="@drawable/bg_floating_menu"
    android:padding="16dp">

    <!-- Center: Ez-Touch -->
    <LinearLayout
        android:id="@+id/btnMenuMain"
        style="@style/FloatingMenuItem"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/imgCenterLogo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_app_logo" />
        <TextView
            style="@style/FloatingMenuText"
            android:text="Ez-Touch" />
    </LinearLayout>

    <!-- Top: Lock -->
    <LinearLayout
        android:id="@+id/btnMenuLock"
        style="@style/FloatingMenuItem"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="12dp">
        <ImageView
            style="@style/FloatingMenuIcon"
            android:src="@drawable/lock" />
        <TextView
            style="@style/FloatingMenuText"
            android:text="Lock" />
    </LinearLayout>

    <!-- Right: Settings -->
    <LinearLayout
        android:id="@+id/btnMenuSetting"
        style="@style/FloatingMenuItem"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true"
        android:layout_marginRight="12dp">
        <ImageView
            style="@style/FloatingMenuIcon"
            android:src="@drawable/settings" />
        <TextView
            style="@style/FloatingMenuText"
            android:text="Settings" />
    </LinearLayout>

    <!-- Bottom: Home -->
    <LinearLayout
        android:id="@+id/btnMenuHome"
        style="@style/FloatingMenuItem"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="12dp">
        <ImageView
            style="@style/FloatingMenuIcon"
            android:src="@drawable/home" />
        <TextView
            style="@style/FloatingMenuText"
            android:text="Home" />
    </LinearLayout>

    <!-- Left: Screenshot -->
    <LinearLayout
        android:id="@+id/btnMenuScreenshot"
        style="@style/FloatingMenuItem"
        android:layout_alignParentLeft="true"
        android:layout_centerVertical="true"
        android:layout_marginLeft="12dp">
        <ImageView
            style="@style/FloatingMenuIcon"
            android:src="@drawable/screenshot" />
        <TextView
            style="@style/FloatingMenuText"
            android:text="Screenshot" />
    </LinearLayout>

</RelativeLayout>
